        {
          "name": "POST /auth/login — Đăng nhập Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  var token = res.data.accessToken || res.data.token;",
                  "  pm.collectionVariables.set('accessToken', token);",
                  "  pm.collectionVariables.set('adminToken', token);",
                  "  if (res.data.user) pm.collectionVariables.set('userId', res.data.user._id);",
                  "}"
                ]
              }
            }
